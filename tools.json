          "type": "number"
        },
        "sampled_records": {
          "type": "number"
        },
        "sampled_amount_usd": {
          "type": "number"
        },
        "interpretation": {
          "type": "string"
        }
      },
      "required": [
        "years",
        "total_matches_across_years",
        "sampled_records",
        "sampled_amount_usd",
        "interpretation"
      ]
    }
  },
