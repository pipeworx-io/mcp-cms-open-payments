          "type": "number"
        },
        "payment_type": {
          "type": "string",
          "enum": [
            "General",
            "Research",
            "Ownership"
          ]
        },
        "sample_per_year": {
          "type": "number",
          "description": "Rows per year (1-100, default 25)."
